# Configuração pública do app (vai para o bundle). Nunca coloque segredos com prefixo EXPO_PUBLIC_.
# URL do Worker do assistente, incluindo /assistant.
EXPO_PUBLIC_ASSISTANT_URL=
# Firebase Console → Configurações do projeto → Seus apps → app da Web. Esses valores são públicos por design;
# a proteção vem da validação do token no Worker.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
